+export const HOTSPOTS = [
+  { id: 'dhaka', place: 'Dhaka', lat: 23.81, lon: 90.41, exposureM: 9 },
+  { id: 'kolkata', place: 'Kolkata', lat: 22.57, lon: 88.36, exposureM: 6 },
