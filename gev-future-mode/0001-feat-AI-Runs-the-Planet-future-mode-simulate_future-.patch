+++ b/src/tools/queries/future.test.mjs
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { composeCatalog, coreTools } from '../index.js';
+import { forgetFutures } from './future.js';
+
+const catalog = () =>
+  composeCatalog({
+    tools: coreTools,
+    services: { app: { baseUrl: 'https://maps.example/' } },
+  });
+
+test('play_future needs a simulation first', async () => {
+  forgetFutures();
+  await assert.rejects(
+    catalog().call('play_future', { which: 'likely' }),
+    (error) => error.code === 'invalid_arguments',
+  );
+});
+
+test('simulate_future returns three futures from given policies', async () => {
+  const result = await catalog().call('simulate_future', {
+    policies: { energy: 80, carbonPrice: 60, adaptation: 40, food: 60, cooperation: 70, tech: 50 },
+    runs: 500,
+    rationale: 'test',
+  });
+  const { futures, stats, policies } = result.data;
+  assert.ok(futures.best.final.warmingC <= futures.worst.final.warmingC + 1);
+  assert.ok(stats.p2C >= 0 && stats.p2C <= 1);
+  // Over budget is scaled down to 360 points.
+  assert.ok(Object.values(policies).reduce((a, b) => a + b, 0) <= 360);
+  assert.match(result.summary, /futures/);
+});
+
+test('play_future returns a link with annotations for a year', async () => {
+  const c = catalog();
+  await c.call('simulate_future', { policies: { energy: 10 }, runs: 300 });
+  const result = await c.call('play_future', { which: 'worst', year: 2076 });
+  assert.ok(result.data.url.startsWith('https://maps.example/'));
+  assert.ok(result.data.view.annotations.length <= 24);
+  assert.match(result.summary, /2076/);
+});
