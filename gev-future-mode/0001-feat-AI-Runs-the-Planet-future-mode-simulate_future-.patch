diff --git a/src/tools/queries/future.js b/src/tools/queries/future.js
new file mode 100644
index 0000000..dd0a66b
--- /dev/null
+++ b/src/tools/queries/future.js
@@ -0,0 +1,154 @@
+/**
+ * AI Runs the Planet: Monte Carlo futures for 2026-2076 from a policy mix,
+ * and a tool that shows one of them in God's Eye View for a given year.
+ * The engine lives in src/future (vendored from ai-runs-the-planet/engine).
+ */
+
+import { defineTool, ToolError } from '../catalog.js';
+import {
+  LEVERS,
+  BUDGET,
+  fitBudget,
+  normalizePolicies,
+  runMonteCarlo,
+  optimizePolicies,
+  explain,
+  annotationsFor,
+  cameraFor,
+  headline,
+  WHICH,
+  START_YEAR,
+  END_YEAR,
+  SOURCES,
+} from '../../future/index.js';
+
+// The last simulation, so play_future can show it without passing it back.
+let last = null;
+export function forgetFutures() {
+  last = null;
+}
+
+const compact = (run) => ({
+  label: run.label,
+  share: run.share,
+  seed: run.seed,
+  score: run.score,
+  final: run.final,
+  events: run.events.map(({ year, title, place, impact, kind }) => ({ year, title, place, impact, kind })),
+  decades: run.years.filter((y) => (y.year - START_YEAR) % 10 === 0),
+});
+
+export const simulateFuture = defineTool({
+  name: 'simulate_future',
+  title: 'Simulate the next 50 years',
+  description:
+    'You are in charge of the world from 2026 to 2076. Choose six policy levers (0-100 each, ' +
+    `${BUDGET} points in total; more is scaled down): ` +
+    LEVERS.map((l) => `${l.key} (${l.help.toLowerCase()})`).join(', ') +
+    '. Runs thousands of Monte Carlo futures anchored to IPCC AR6 warming and sea-level pathways ' +
+    'and UN population projections, with chance events (pandemics, wars, tipping points, ' +
+    'breakthroughs). Returns the best (95th percentile), most likely (median) and scariest ' +
+    '(5th percentile) future and statistics across all runs. Set let_ai_decide to have the ' +
+    'built-in optimizer choose the levers instead. Then call play_future to show one on the globe. ' +
+    'These are possible futures, not predictions.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      policies: {
+        type: 'object',
+        description: 'Lever values 0-100; missing levers are 50.',
+        properties: Object.fromEntries(
+          LEVERS.map((l) => [l.key, { type: 'number', minimum: 0, maximum: 100, description: l.help }]),
+        ),
+        additionalProperties: false,
+      },
+      let_ai_decide: {
+        type: 'boolean',
+        description: 'Ignore policies and let the optimizer pick the mix with the best typical and least bad worst-case future.',
+      },
+      rationale: {
+        type: 'string',
+        maxLength: 2000,
+        description: 'Why you chose these levers, kept with the result.',
+      },
+      runs: { type: 'integer', minimum: 100, maximum: 10000, description: 'Number of futures (default 5000).' },
+      seed: { type: 'integer', minimum: 1, maximum: 2147483647 },
+    },
+    additionalProperties: false,
+  },
+  // Pure computation; it reads no service, but core tools are offered where
+  // the app is, since play_future shows the result there.
+  requires: ['app'],
+  run(args) {
+    const seed = args.seed ?? 2026;
+    let policies, futures, rationale;
+    if (args.let_ai_decide) {
+      ({ policies, futures, rationale } = optimizePolicies({ seed }));
+    } else {
+      policies = fitBudget(normalizePolicies(args.policies ?? {}));
+      futures = runMonteCarlo(policies, { runs: args.runs ?? 5000, seed });
+      rationale = args.rationale ? [args.rationale] : explain(policies, futures);
+    }
+    last = futures;
+    const s = futures.stats;
+    return {
+      summary:
+        `Ran ${futures.runs.toLocaleString('en')} futures. Median warming by 2076: ${s.medianWarming} °C ` +
+        `(90% of futures ${s.warming90[0]}-${s.warming90[1]} °C); ${Math.round(s.p2C * 100)}% stay below 2 °C; ` +
+        `${Math.round(s.tippingShare * 100)}% cross a tipping point. Best: ${futures.best.final.warmingC} °C, ` +
+        `most likely: ${futures.likely.final.warmingC} °C, scariest: ${futures.worst.final.warmingC} °C. ` +
+        'Call play_future to show one.',
+      data: {
+        policies,
+        rationale,
+        stats: s,
+        futures: Object.fromEntries(WHICH.map((w) => [w, compact(futures[w])])),
+        sources: SOURCES,
+        note: 'Possible futures, not predictions.',
+      },
+    };
+  },
+});
+
+export const playFuture = defineTool({
+  name: 'play_future',
+  title: 'Show a simulated future',
+  description:
+    'Shows one future from the last simulate_future call in God\'s Eye View at a given year: ' +
+    'red pins for disasters, green pins for breakthroughs, amber marks for coastal cities losing ' +
+    'people to the sea, with the camera on that decade\'s defining event. Call it for several ' +
+    'years (for example 2036, 2056, 2076) to walk through the future.',
+  inputSchema: {
+    type: 'object',
+    properties: {
+      which: { type: 'string', enum: [...WHICH], description: 'best, likely or worst' },
+      year: { type: 'integer', minimum: START_YEAR, maximum: END_YEAR, description: 'Default 2076.' },
+    },
+    required: ['which'],
+    additionalProperties: false,
+  },
+  requires: ['app'],
+  async run(args, { tools }) {
+    if (!last) throw new ToolError('invalid_arguments', 'Run simulate_future first.');
+    const run = last[args.which];
+    const year = args.year ?? END_YEAR;
+    const cam = cameraFor(run, year);
+    const annotations = annotationsFor(run, year, last.policies.adaptation);
+    const shown = await tools.call('show_in_gods_eye_view', {
+      camera: {
+        lat: cam.lat,
+        lon: cam.lon,
+        altitude_m: cam.alt,
+        heading_deg: 0,
+        pitch_deg: cam.pitch,
+      },
+      annotations,
+    });
+    const line = headline(run, year);
+    const focus = cam.event ? ` Defining event: ${cam.event.year} ${cam.event.title} in ${cam.event.place} (${cam.event.impact}).` : '';
+    return {
+      summary: `${run.label} future, ${line}.${focus} ${shown.summary}`,
+      data: { ...shown.data, which: args.which, year, headline: line, event: cam.event },
+    };
+  },
+});
diff --git a/src/tools/queries/future.test.mjs b/src/tools/queries/future.test.mjs
